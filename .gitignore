# ── Virtual environment ──────────────────────────────────────────
footdrop_env/
venv/
.venv/
env/

# ── Python caches / build ────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ── OS / editor cruft ────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# ── Sweep outputs ────────────────────────────────────────────────
sweep_cache/
sweep_results.json

# ── Large data & model artifacts (optional) ──────────────────────
# These are big and/or regenerable. Uncomment to keep them out of git
# (e.g. if you version them with Git LFS or distribute them separately).
# The windowed dataset is rebuilt by `python extract_dataset_sliding.py`.
#
# enabl3s_dataset_sliding/
# best_model.pt
# *.npy
# *.pt

# ── Unprocessed raw-CSV source data (~18 GB; regenerable pipeline INPUT) ──
# Kept on disk, out of git. The windowed dataset (enabl3s_dataset_sliding/) and
# golden_vectors/ — the PROCESSED outputs — stay tracked.
Python/Processed_data/
Python/Extra_data/

# ── Vitis HLS generated output (regenerated on every C-sim / synthesis) ──
# Each component keeps all HLS build output in a nested <name>/<name>/ dir.
# Source (.cpp/.h), hls_config.cfg, and *_goldens/ stay tracked.
HLS/conv1/conv1/
HLS/conv2/conv2/
HLS/LSTM/LSTM/
HLS/Relu_Max_1/Relu_Max_1/
HLS/Relu_Max_2/Relu_Max_2/
HLS/linear/linear/
HLS/inference/inference/

# Stray per-component build files, IDE workspace state, editor index caches
**/*.hlscompile_summary
**/dfx_runtime.txt
**/.cache/
_ide/
.vitisWorkspace.json
